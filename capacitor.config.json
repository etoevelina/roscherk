{
  "appId": "tech.kuick.roscherk",
  "appName": "Росчерк",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f3f4ef",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "backgroundColor": "#f3f4ef",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
